# Application Settings
PROJECT_NAME="OFC HR Backend API"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=True
ENABLE_DOCS=True

# ── Security & Secrets ──────────────────────────────────────────────
SECRET_KEY="your_secret_key_minimum_32_bytes_placeholder"
ACCESS_TOKEN_SECRET="your_access_token_secret_placeholder"
REFRESH_TOKEN_SECRET="your_refresh_token_secret_placeholder"
RESET_TOKEN_SECRET="your_reset_token_secret_placeholder"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_RESET_EXPIRE_MINUTES=15

# JWT Claims
JWT_ISSUER="ofc-hr-api"
JWT_AUDIENCE="ofc-hr-client"
JWT_CLOCK_SKEW_SECONDS=30

# Brute-force protection
MAX_FAILED_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# Session Middleware
SESSION_SECRET_KEY="your_session_secret_key_placeholder"

# ── Database Configuration ──────────────────────────────────────────
# Production / Supabase PostgreSQL URL:
DATABASE_URL="postgresql+asyncpg://postgres:Bindu%40134366@your_supabase_host:6543/postgres"

# Connection Pool Config
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_PRE_PING=True

# Redis Cache & Rate Limiting
REDIS_URL="memory://"

# ── CORS Whitelist ──────────────────────────────────────────────────
CORS_ORIGINS="https://ofc-hr-for.vercel.app/"

# Cookie Domain (leave empty for default)
COOKIE_DOMAIN=""

# ── Rate Limiting Settings ──────────────────────────────────────────
RATE_LIMIT_LOGIN="5/minute"
RATE_LIMIT_REGISTER="3/minute"
RATE_LIMIT_SSO="10/minute"

# ── Frontend URL ────────────────────────────────────────────────────
FRONTEND_URL="https://ofc-hr-for.vercel.app/"

# ── SSO Credentials ────────────────────────────────────────────────
OKTA_DOMAIN="dev-your_okta_domain.okta.com"
OKTA_CLIENT_ID="your_okta_client_id_placeholder"
OKTA_CLIENT_SECRET="your_okta_client_secret_placeholder"
OKTA_REDIRECT_URI="http://localhost:8000/auth/okta/callback"

GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret_placeholder"
GOOGLE_REDIRECT_URI="http://localhost:8000/auth/google/callback"

MICROSOFT_TENANT_ID="common"
MICROSOFT_CLIENT_ID="your_microsoft_client_id_placeholder"
MICROSOFT_CLIENT_SECRET="your_microsoft_client_secret_placeholder"
MICROSOFT_REDIRECT_URI="http://localhost:8000/api/v1/sso/microsoft/callback"

# ── SMTP / Email Configuration ──────────────────────────────────────
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER="sy5438066@gmail.com"
SMTP_PASSWORD="ybaoqfnnzjmqomkh"
EMAILS_FROM_EMAIL="noreply@example.com"
EMAILS_FROM_NAME="OFC HR Platform"

# ── Supabase ────────────────────────────────────────────────────────
SUPABASE_URL="https://your_project.supabase.co"
SUPABASE_ANON_KEY="your_supabase_anon_key_placeholder"

AUTH0_DOMAIN="your_auth0_domain.auth0.com"
AUTH0_CLIENT_ID="your_auth0_client_id_placeholder"
AUTH0_CLIENT_SECRET="your_auth0_client_secret_placeholder"
AUTH0_SECRET="your_auth0_secret_placeholder"

APP_BASE_URL="http://localhost:3000"
PORT=8000
